[Unit]
Description=SoftMobile internal event router and restricted OpenClaw agent wake-up
After=docker.service softmobile-pilot-executor.service
Requires=docker.service
ConditionPathExists=/opt/openclaw-lab/supervisor/event_router.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/openclaw-lab/supervisor
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/openclaw-lab/supervisor/event_router.py --dispatch
TimeoutStartSec=70
MemoryMax=128M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/openclaw-lab/workspace/softmobile-supervisor
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
