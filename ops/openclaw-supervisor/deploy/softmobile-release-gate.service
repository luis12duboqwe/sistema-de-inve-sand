[Unit]
Description=SoftMobile independent prelaunch readiness and security certification
After=softmobile-event-router.service
ConditionPathExists=/opt/openclaw-lab/supervisor/release_gate.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/openclaw-lab/supervisor
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/openclaw-lab/supervisor/release_gate.py
TimeoutStartSec=20
MemoryMax=96M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/openclaw-lab/workspace/softmobile-supervisor
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
